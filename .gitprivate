# Files the team repository, udecode/plate-private, tracks through .git-private in
# the same folder. A team clone of udecode/plate reads this file through
# core.excludesFile, so its git never sees them. Contributors' clones do not
# have these files.

# A root entry is private unless it is listed here.
/*
!/.agents/
!/.changeset/
!/.claude/
!/.codex/
!/.github/
!/.vscode/
!/apps/
!/config/
!/content/
!/packages/
!/patches/
!/skills/
!/templates/
!/tooling/
!/.gitattributes
!/.gitignore
!/.gitprivate
!/.npmrc
!/.nvmrc
!/AGENTS.md
!/CODING_STANDARDS.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/bunfig.toml
!/languine.json
!/lefthook.yml
!/oxfmt.config.ts
!/oxlint.config.ts
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/postcss.config.mjs
!/skills-lock.json
!/tsconfig.json
!/turbo.json
!/vercel.json

# Tests, the same globs as reviewPaths.tests in .agents/pstack.json.
*.slow.*
*.spec.*
*.test.*
__tests__/
/packages/*/test/
/packages/*/type-tests/
/apps/*/tests/

# What tests, measures or probes the code.
__fixtures__/
playwright*.config.*
vitest.config.*
*-test-support.*
*.test-run.*
/packages/*/tsconfig.entrypoints/tests.json
/packages/*/benchmarks/
/packages/platejs/scripts/code-block-text-flow-browser.mjs
/packages/platejs/src/markdown/lib/internal/commonmark-spec.d.ts
/packages/plitejs/scripts/authored-decision-order*
/packages/plitejs/scripts/yjs/benchmark-event-change-bridge.ts
/apps/*/src/app/dev/
/apps/www/src/app/api/dev/
/apps/www/src/app/(blocks)/blocks/*-proof/
/apps/plite/src/app/focus-blur/
/apps/plite/src/app/mobile-lab/
/apps/plite/src/app/suggestion-first-paint/
/apps/plite/src/app/runtime-entrypoints/
/apps/plite/src/runtime-entrypoint-proof.generated.ts
/apps/plite/scripts/build-app-if-stale.*
/apps/plite/scripts/build-browser-if-stale.*
/apps/plite/scripts/inspect-plite-browser.*
/apps/plite/scripts/merge-plite-browser-summaries.*
/apps/plite/scripts/plite-browser-runner.*
/apps/plite/scripts/plite-proof-inputs.*
/apps/plite/scripts/run-plite-browser.*
/apps/plite/scripts/plite-static-server.*
/apps/plite/scripts/serve.*
/apps/www/scripts/autoformat-input-rules*
/apps/www/scripts/*-probe.mts
/apps/www/scripts/run-*-perf.mts
/apps/www/scripts/registry-create-install-e2e.mts
/config/plite-source-test-setup.ts
/config/plite-test-jsx*
/tooling/e2e/
/tooling/device/
/tooling/ime/
/tooling/plite/donor/
/tooling/config/bunTestSetup.ts
/tooling/config/load-trace-preload.ts
/tooling/config/vitest-load-trace.mjs
/tooling/scripts/bench-targets.*
/tooling/scripts/benchmark-shared-plugin-identity.*
/tooling/scripts/check-declaration-consumer.*
/tooling/scripts/check-plite.*
/tooling/scripts/check-plite-release-artifacts.test.mjs
/tooling/scripts/measure-browser-handle.*
/tooling/scripts/playtest.*
/tooling/scripts/proof-worktree.*
/tooling/scripts/serving-fingerprint.*
/tooling/scripts/test-deferred.*
/tooling/scripts/test-slowest.*
/tooling/scripts/test-suite.*
/tooling/scripts/type-probe.*
/tooling/scripts/knowledge/baseline.json
/tooling/scripts/plate-schema-adoption-baseline.json
/tooling/oxlint/plate-baseline.private.json

# Public whatever the rules above say.
!/.agents/**
!/.claude/**
!/apps/www/src/app/dev/
/apps/www/src/app/dev/*
!/apps/www/src/app/dev/editor-perf/
/apps/www/src/app/dev/editor-perf/*
!/apps/www/src/app/dev/editor-perf/find-surface.tsx
!/apps/www/src/app/dev/editor-perf/page.tsx
!/apps/www/src/app/dev/editor-perf/find-workload.ts
!/apps/www/src/app/dev/editor-perf/plugin-census.ts
!/apps/www/src/app/dev/editor-perf/workloads.ts
!/apps/www/scripts/run-editor-perf.mts
