{
  "name": "@platejs/cli",
  "version": "54.0.0-beta.0",
  "description": "Generate exact Plate editor schema contracts and migrations.",
  "keywords": [
    "codegen",
    "editor",
    "plate",
    "schema",
    "typescript"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/cli"
  },
  "bin": {
    "plate": "./dist/bin.js"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "brl": "echo 'No barrels to generate'",
    "build": "tsdown --config tsdown.config.mts --log-level warn",
    "clean": "rimraf dist",
    "lint": "node ../../tooling/scripts/plate-pkg.cjs p:lint",
    "lint:fix": "node ../../tooling/scripts/plate-pkg.cjs p:lint:fix",
    "test": "bun test src test",
    "test:performance": "bun test/performance.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@antfu/ni": "24.3.0",
    "chokidar": "4.0.3",
    "commander": "14.0.1",
    "esbuild": "0.25.12",
    "get-tsconfig": "5.0.0-beta.5",
    "kleur": "4.1.5",
    "ora": "8.2.0",
    "prompts": "2.4.2",
    "typescript": "7.0.2",
    "zod": "3.25.61"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/prompts": "2.4.9",
    "platejs": "workspace:^"
  },
  "peerDependencies": {
    "platejs": ">=54.0.0-beta.1"
  }
}
