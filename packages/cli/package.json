{
  "name": "@platejs/cli",
  "version": "54.0.0-beta.0",
  "description": "Generate exact Plate editor schema contracts and migrations.",
  "keywords": [
    "codegen",
    "editor",
    "plate",
    "schema",
    "typescript"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "plate": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "brl": "echo 'No barrels to generate'",
    "build": "tsdown --config tsdown.config.mts --log-level warn",
    "clean": "rimraf dist",
    "lint": "plate-pkg p:lint",
    "lint:fix": "plate-pkg p:lint:fix",
    "test": "bun test test",
    "test:performance": "bun test/performance.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@platejs/core": "workspace:^",
    "@platejs/plite": "workspace:^",
    "chokidar": "4.0.3",
    "commander": "14.0.1",
    "esbuild": "0.25.12",
    "get-tsconfig": "5.0.0-beta.5",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@plate/scripts": "workspace:*",
    "@types/node": "24.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
