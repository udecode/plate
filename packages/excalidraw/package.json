{
  "name": "@platejs/excalidraw",
  "version": "54.0.0-beta.0",
  "description": "Excalidraw plugin for Plate",
  "keywords": [
    "plate",
    "plugin",
    "slate"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/excalidraw"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "brl": "plate-pkg p:brl",
    "build": "plate-pkg p:build",
    "build:watch": "plate-pkg p:build:watch",
    "clean": "plate-pkg p:clean",
    "lint": "plate-pkg p:lint",
    "lint:fix": "plate-pkg p:lint:fix",
    "test": "plate-pkg p:test",
    "test:watch": "plate-pkg p:test:watch",
    "typecheck": "plate-pkg p:typecheck"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@platejs/core": "workspace:^",
    "@platejs/plite": "workspace:^",
    "@platejs/plite-react": "workspace:^",
    "@platejs/utils": "workspace:^",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@plate/scripts": "workspace:*",
    "@types/lodash": "^4.17.13"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  }
}
