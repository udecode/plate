{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/root",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/root.tsbuildinfo"
  },
  "exclude": [
    "../src/browser/**/*",
    "../src/playwright/**/*",
    "../src/proof/**/*",
    "../src/react/**/*",
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*.slow.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/**/*"],
  "references": [
    {
      "path": "../../platejs/tsconfig.entrypoints/proxies.json"
    },
    {
      "path": "../../platejs/tsconfig.entrypoints/root.json"
    }
  ]
}
