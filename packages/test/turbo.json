{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "env": ["CI"],
      "inputs": [
        "src/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/config/direct-package.config.mts",
        "$TURBO_ROOT$/tooling/config/tsdown.config.ts",
        "$TURBO_ROOT$/tooling/scripts/check-package-build-artifacts.mjs",
        "tsconfig.build.json",
        "tsdown.config.mts"
      ],
      "outputLogs": "errors-only",
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": true,
      "dependsOn": [
        "lint:partition:browser",
        "lint:partition:playwright",
        "lint:partition:proof",
        "lint:partition:react",
        "lint:partition:root"
      ],
      "inputs": [
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-package-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:partition:browser": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/browser/**",
        "test/browser/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/oxlint/entrypoint-dag-plugin.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:partition:playwright": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/playwright/**",
        "test/playwright/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/oxlint/entrypoint-dag-plugin.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:partition:proof": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/proof/**",
        "test/proof/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/oxlint/entrypoint-dag-plugin.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:partition:react": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/react/**",
        "test/react/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/oxlint/entrypoint-dag-plugin.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:partition:root": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/browser/**",
        "!src/playwright/**",
        "!src/proof/**",
        "!src/react/**",
        "test/**",
        "!test/browser/**",
        "!test/playwright/**",
        "!test/proof/**",
        "!test/react/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/oxlint/entrypoint-dag-plugin.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "test:partition:browser",
        "test:partition:proof",
        "test:partition:react",
        "test:partition:root"
      ],
      "inputs": [
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-package-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:partition:browser": {
      "cache": true,
      "dependsOn": ["typecheck:partition:browser"],
      "inputs": [
        "src/browser/**",
        "test/browser/**",
        "$TURBO_ROOT$/config/plite-source-aliases.ts",
        "$TURBO_ROOT$/config/plite-source-test-setup.ts",
        "$TURBO_ROOT$/tooling/config/bunTestSetup.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "bunfig.toml"
      ],
      "env": ["CI"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:partition:proof": {
      "cache": true,
      "dependsOn": [
        "typecheck:partition:browser",
        "typecheck:partition:playwright",
        "typecheck:partition:proof"
      ],
      "inputs": [
        "src/proof/**",
        "test/proof/**",
        "$TURBO_ROOT$/config/plite-source-aliases.ts",
        "$TURBO_ROOT$/config/plite-source-test-setup.ts",
        "$TURBO_ROOT$/tooling/config/bunTestSetup.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "bunfig.toml"
      ],
      "env": ["CI"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:partition:react": {
      "cache": true,
      "dependsOn": [
        "platejs#typecheck:partition:react",
        "typecheck:partition:react"
      ],
      "inputs": [
        "src/react/**",
        "test/react/**",
        "$TURBO_ROOT$/config/plite-source-aliases.ts",
        "$TURBO_ROOT$/config/plite-source-test-setup.ts",
        "$TURBO_ROOT$/tooling/config/bunTestSetup.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "bunfig.toml"
      ],
      "env": ["CI"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:partition:root": {
      "cache": true,
      "dependsOn": [
        "platejs#typecheck:partition:proxies",
        "platejs#typecheck:partition:root",
        "typecheck:partition:root"
      ],
      "inputs": [
        "src/**",
        "!src/browser/**",
        "!src/playwright/**",
        "!src/proof/**",
        "!src/react/**",
        "test/**",
        "!test/browser/**",
        "!test/playwright/**",
        "!test/proof/**",
        "!test/react/**",
        "$TURBO_ROOT$/config/plite-source-aliases.ts",
        "$TURBO_ROOT$/config/plite-source-test-setup.ts",
        "$TURBO_ROOT$/tooling/config/bunTestSetup.ts",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "bunfig.toml"
      ],
      "env": ["CI"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "typecheck:partition:browser",
        "typecheck:partition:playwright",
        "typecheck:partition:proof",
        "typecheck:partition:react",
        "typecheck:partition:root",
        "typecheck:contracts"
      ],
      "inputs": [
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-package-task.mjs"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "typecheck:contracts": {
      "cache": true,
      "dependsOn": [
        "typecheck:partition:browser",
        "typecheck:partition:playwright",
        "typecheck:partition:proof",
        "typecheck:partition:react",
        "typecheck:partition:root"
      ],
      "inputs": [
        "test/public-api-contract.tsx",
        "tsconfig.public-api.json",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "$TURBO_ROOT$/config/workspace-source-entries.mjs",
        "$TURBO_ROOT$/tooling/scripts/typecheck-package-source.mjs",
        "tsconfig.entrypoints/contracts.json"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "typecheck:partition:browser": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/browser/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "tsconfig.entrypoints/browser.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        ".turbo/entrypoint-types/browser/**",
        ".turbo/entrypoint-types/browser.tsbuildinfo"
      ]
    },
    "typecheck:partition:playwright": {
      "cache": true,
      "dependsOn": [
        "platejs#typecheck:partition:root",
        "typecheck:partition:browser",
        "typecheck:partition:proof",
        "typecheck:partition:root"
      ],
      "inputs": [
        "src/playwright/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "tsconfig.entrypoints/playwright.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        ".turbo/entrypoint-types/playwright/**",
        ".turbo/entrypoint-types/playwright.tsbuildinfo"
      ]
    },
    "typecheck:partition:proof": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "src/proof/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "tsconfig.entrypoints/proof.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        ".turbo/entrypoint-types/proof/**",
        ".turbo/entrypoint-types/proof.tsbuildinfo"
      ]
    },
    "typecheck:partition:react": {
      "cache": true,
      "dependsOn": ["platejs#typecheck:partition:react"],
      "inputs": [
        "src/react/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "tsconfig.entrypoints/react.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        ".turbo/entrypoint-types/react/**",
        ".turbo/entrypoint-types/react.tsbuildinfo"
      ]
    },
    "typecheck:partition:root": {
      "cache": true,
      "dependsOn": [
        "platejs#typecheck:partition:proxies",
        "platejs#typecheck:partition:root"
      ],
      "inputs": [
        "src/**",
        "!src/browser/**",
        "!src/playwright/**",
        "!src/proof/**",
        "!src/react/**",
        "!src/**/*.spec.*",
        "!src/**/*.test.*",
        "!src/**/*.slow.*",
        "!src/**/*-contract.*",
        "!src/**/__tests__/**",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-dag.mjs",
        "$TURBO_ROOT$/tooling/entrypoints/entrypoint-turbo.mjs",
        "$TURBO_ROOT$/tooling/scripts/run-entrypoint-task.mjs",
        "$TURBO_ROOT$/tooling/config/global.d.ts",
        "$TURBO_ROOT$/tooling/config/tsconfig.base.json",
        "$TURBO_ROOT$/tooling/config/tsconfig.test.json",
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.json",
        "tsconfig.entrypoints/root.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        ".turbo/entrypoint-types/root/**",
        ".turbo/entrypoint-types/root.tsbuildinfo"
      ]
    }
  }
}
