{
  "name": "@platejs/plite-history",
  "version": "54.0.0-beta.2",
  "description": "Canonical change history for Plite editors.",
  "keywords": [
    "@platejs/plite",
    "change",
    "editor",
    "history",
    "redo",
    "save",
    "stack",
    "undo"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/plite-history"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "brl": "echo 'No barrels to generate'",
    "build": "tsdown --config tsdown.config.mts --log-level warn",
    "clean": "rimraf dist lib",
    "lint": "plate-pkg p:lint",
    "lint:fix": "plate-pkg p:lint:fix",
    "test": "bun test --preload ../../config/plite-source-test-setup.ts",
    "typecheck": "plate-pkg p:typecheck"
  },
  "devDependencies": {
    "@plate/scripts": "workspace:*",
    "@platejs/plite": "workspace:^",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@platejs/plite": ">=54.0.0-beta.2"
  }
}
