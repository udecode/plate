{
  "name": "@platejs/core",
  "version": "54.0.0-beta.1",
  "description": "The core Plate plugin runtime for Plite editors",
  "keywords": [
    "contentEditable",
    "editor",
    "framework",
    "html",
    "plate",
    "plugin",
    "rich text",
    "wysiwyg"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.js",
      "default": "./dist/internal/index.js"
    },
    "./react": "./dist/react/index.js",
    "./react/internal": {
      "types": "./dist/react/internal/index.d.ts",
      "import": "./dist/react/internal/index.js",
      "default": "./dist/react/internal/index.js"
    },
    "./react/test": {
      "types": "./dist/react/test-entry.d.ts",
      "import": "./dist/react/test-entry.js",
      "default": "./dist/react/test-entry.js"
    },
    "./static": "./dist/static/index.js",
    "./static/internal": {
      "types": "./dist/static/internal/index.d.ts",
      "import": "./dist/static/internal/index.js",
      "default": "./dist/static/internal/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "brl": "plate-pkg p:brl",
    "build": "tsdown --config tsdown.config.mts --log-level warn",
    "build:watch": "plate-pkg p:build:watch",
    "clean": "plate-pkg p:clean",
    "lint": "plate-pkg p:lint",
    "lint:fix": "plate-pkg p:lint:fix",
    "test": "plate-pkg p:test",
    "test:watch": "plate-pkg p:test:watch",
    "typecheck": "plate-pkg p:typecheck && tsc --project tsconfig.test.json --noEmit && pnpm typecheck:contracts",
    "typecheck:contracts": "rimraf ../../.tmp/core-type-contract-declarations && tsc --project tsconfig.type-tests.json"
  },
  "dependencies": {
    "@platejs/plite": "workspace:^",
    "@platejs/plite-dom": "workspace:^",
    "@platejs/plite-history": "workspace:^",
    "@platejs/plite-hyperscript": "workspace:^",
    "@platejs/plite-react": "workspace:^",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "@udecode/react-hotkeys": "workspace:*",
    "@udecode/react-utils": "workspace:*",
    "@udecode/utils": "workspace:*",
    "clsx": "^2.1.1",
    "html-entities": "^2.6.0",
    "is-hotkey": "^0.2.0",
    "jotai": "~2.8.4",
    "jotai-optics": "0.4.0",
    "jotai-x": "2.3.4",
    "lodash": "^4.17.21",
    "mdast-util-math": "3.0.0",
    "mdast-util-mdx": "3.0.0",
    "mutative": "^1.1.0",
    "nanoid": "^5.1.5",
    "optics-ts": "2.4.1",
    "react-compiler-runtime": "^1.0.0",
    "use-deep-compare": "^1.3.0",
    "zustand": "^5.0.5",
    "zustand-x": "6.2.1"
  },
  "devDependencies": {
    "@plate/scripts": "workspace:*",
    "@platejs/test-utils": "workspace:^",
    "fast-check": "^3.23.2"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  }
}
