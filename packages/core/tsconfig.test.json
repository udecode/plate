{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*-contract.ts",
    "src/**/*-contract.tsx",
    "../../tooling/config/global.d.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "types": ["node", "bun-types", "bun-types/test-globals"]
  }
}
