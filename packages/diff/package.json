{
  "name": "@platejs/diff",
  "version": "54.0.0-beta.2",
  "description": "Compute a diff of two Plite documents",
  "keywords": [
    "plate",
    "plite",
    "plugin"
  ],
  "homepage": "https://platejs.org",
  "bugs": {
    "url": "https://github.com/udecode/plate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/diff"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
