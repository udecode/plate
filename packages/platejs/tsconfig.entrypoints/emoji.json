{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/emoji",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/emoji.tsbuildinfo"
  },
  "exclude": [
    "../src/emoji/react/**/*",
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*.slow.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/emoji/**/*"],
  "references": [
    {
      "path": "./combobox.json"
    },
    {
      "path": "./core.json"
    }
  ]
}
