{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/tag-react",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/tag-react.tsbuildinfo"
  },
  "exclude": [
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*.slow.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/react/features/tag/**/*"],
  "references": [
    {
      "path": "./core.json"
    },
    {
      "path": "./react-core.json"
    },
    {
      "path": "./tag.json"
    }
  ]
}
