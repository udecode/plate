{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/docx-export",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/docx-export.tsbuildinfo"
  },
  "exclude": [
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*.slow.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/docx/export/**/*"],
  "references": [
    {
      "path": "./callout.json"
    },
    {
      "path": "./core.json"
    },
    {
      "path": "./docx-internal.json"
    },
    {
      "path": "./layout.json"
    },
    {
      "path": "./math.json"
    },
    {
      "path": "./proxies.json"
    },
    {
      "path": "./standard-basic-nodes.json"
    },
    {
      "path": "./standard-code-block.json"
    },
    {
      "path": "./static.json"
    },
    {
      "path": "./toc.json"
    }
  ]
}
