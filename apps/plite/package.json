{
  "name": "plite",
  "version": "0.0.0-private",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "pretest:plite-browser": "node scripts/build-browser-if-stale.mjs",
    "pretest:plite-browser:chromium": "node scripts/build-browser-if-stale.mjs",
    "pretest:plite-browser:dev": "node scripts/build-browser-if-stale.mjs",
    "pretest:plite-browser:project": "node scripts/build-browser-if-stale.mjs",
    "pretest:plite-browser:smoke": "node scripts/build-browser-if-stale.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "PLITE_SERVE_HOST=0.0.0.0 node scripts/serve.mjs",
    "test:plite-browser": "node scripts/run-plite-browser.mjs matrix",
    "test:plite-browser:chromium": "node scripts/run-plite-browser.mjs chromium",
    "test:plite-browser:dev": "pnpm test:plite-browser:smoke",
    "test:plite-browser:project": "node scripts/run-plite-browser.mjs project",
    "test:plite-browser:smoke": "node scripts/run-plite-browser.mjs smoke",
    "test:runner": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@playwright/test": "1.61.0",
    "next": "16.3.2",
    "nuqs": "2.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@faker-js/faker": "9.8.0",
    "@platejs/test": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "platejs": "workspace:*",
    "plitejs": "workspace:*"
  }
}
