{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm -w build:www:ci",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "bash -c '[ \"$VERCEL_GIT_COMMIT_MESSAGE\" = \"Version Packages\" ]'",
  "installCommand": "pnpm install --no-frozen-lockfile"
}
