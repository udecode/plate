{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "outDir": "dist",
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "./**/*.mts"],
  "exclude": ["node_modules"]
}
