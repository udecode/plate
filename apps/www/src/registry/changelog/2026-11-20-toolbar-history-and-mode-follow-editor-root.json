          "section": null
        }
      }
    },
    {
      "id": "2026-11-20-toolbar-history-and-mode-follow-editor-root-2",
      "kind": "behavior",
      "summary": "Viewing chosen while no `EditorContent` is mounted now puts the editor root in Viewing through `setEditorViewing`, so choosing Editing after an `EditorContent` mounts makes it writable again. Under an `EditorProvider` that holds an editor view, Viewing writes that view's Mode, and Editing also clears the view's own lock.",
      "details": [],
      "migrationNotes": [],
