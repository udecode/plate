    {
      "id": "2026-11-20-fixed-toolbar-keep-undo-redo-mode-cbfe5bd9",
      "kind": "behavior",
      "summary": "Undo and Redo call `useEditorHistory()` with no editor, so they run through the editor root instead of the editing area that holds the caret. With the caret in a read-only note they stay in the toolbar and undo a page edit. The toolbar hides them only while the editor root is in Viewing. They refuse to undo an edit made in a note that was locked afterward, as the keyboard shortcut does.",
      "details": [],
      "migrationNotes": [],
      "targets": ["fixed-toolbar", "history-toolbar-button"],
