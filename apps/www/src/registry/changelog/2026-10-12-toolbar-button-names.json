          "entry": "2026-10-12-toolbar-button-names",
          "section": null
        }
      }
    },
    {
      "id": "2026-10-12-toolbar-duplicate-labels",
      "kind": "wiring",
      "summary": "Remove each `aria-label` that repeated the button's `tooltip`. The accessible names stay the same.",
