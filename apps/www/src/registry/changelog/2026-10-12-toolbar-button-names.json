  "entries": [
    {
      "id": "2026-10-12-toolbar-button-tooltip-name",
      "kind": "fix",
      "summary": "`ToolbarButton` uses a string `tooltip` as the button's accessible name when you pass no `aria-label`. Screen readers announce icon-only buttons such as Link by that name, and `getByRole('button', { name: 'Link' })` finds them.",
      "details": [],
      "migrationNotes": [],
      "targets": ["toolbar"],
      "source": {
        "line": 14,
        "row": 1,
        "legacyRelease": {
          "date": "2026-10-12",
          "entry": "2026-10-12-toolbar-button-names",
          "section": null
        }
      }
    },
    {
      "id": "2026-10-12-toolbar-button-value-names",
      "kind": "fix",
      "summary": "Name the button with its label and current value, such as \"Turn into: Text\" and \"Editing mode: Editing\". The mode button keeps its name when narrow screens hide its text.",
      "details": [],
      "migrationNotes": [],
      "targets": ["turn-into-toolbar-button", "mode-toolbar-button"],
      "source": {
        "line": 16,
        "row": 2,
        "legacyRelease": {
          "date": "2026-10-12",
          "entry": "2026-10-12-toolbar-button-names",
          "section": null
        }
      }
    },
    {
      "id": "2026-10-12-toolbar-split-button-names",
      "kind": "fix",
      "summary": "Name both halves of each split button, such as \"Bulleted list\" and \"Bulleted list styles\", or \"Image\" and \"Image options\".",
      "details": [],
      "migrationNotes": [],
      "targets": ["list-toolbar-button", "media-toolbar-button"],
      "source": {
        "line": 18,
