    {
      "id": "2026-11-25-editor-dropdown-menu-keep-screen-keyboard-up-35977d19",
      "kind": "fix",
      "summary": "On a phone, a toolbar menu that you open with a finger while you type in the editor now leaves focus in the editor, so the on-screen keyboard stays up. Before, the menu took focus and the keyboard closed. Taps on the menu's items and submenus do not take focus either, the menu opens non-modal, and the table menu's size grid does not focus its first cell. A mouse, a pen or a key press opens the menu as before and moves focus into it, and so does a tap while the keyboard is down or the editor does not have focus.",
      "details": [],
      "migrationNotes": [],
      "targets": ["editor-dropdown-menu", "table-toolbar-button"],
