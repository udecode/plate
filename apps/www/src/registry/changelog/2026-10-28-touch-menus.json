    {
      "id": "2026-10-28-editor-dropdown-menu-open-on-tap",
      "kind": "fix",
      "summary": "On a touch screen, a dropdown menu now opens on a tap, so a swipe that scrolls the toolbar no longer opens the menu of the button it starts on. A mouse press still opens the menu on press.",
