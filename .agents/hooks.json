{
  "plate-hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "cd .. && { [ ! -f .agents/pstack/head.mjs ] || node .agents/pstack/head.mjs; } >/dev/null 2>&1; printf '{}'",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "payload=$(cat); cd .. && { [ ! -f .agents/pstack/setup.mjs ] || printf '%s' \"$payload\" | node .agents/pstack/setup.mjs --hook --install 'pnpm install --offline' --installs node_modules; }; { [ ! -f tooling/scripts/git-private.mjs ] || printf '%s' \"$payload\" | node tooling/scripts/git-private.mjs start --hook >/dev/null; } || true",
        "timeout": 600
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f .agents/skills/cleanup/scripts/scan.mjs ] || node .agents/skills/cleanup/scripts/scan.mjs --brief --auto --hook --repo .; }",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f .agents/skills/contributor-setup/scripts/doctor.mjs ] || node .agents/skills/contributor-setup/scripts/doctor.mjs --hook; }",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/dev-servers.mjs ] || node tooling/scripts/dev-servers.mjs --hook; }",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "cd .. && { [ ! -f .agents/pstack/guard.mjs ] || node .agents/pstack/guard.mjs; }",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "cd .. && { [ ! -f tooling/scripts/type-probe-guard.mjs ] || node tooling/scripts/type-probe-guard.mjs; }",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "read_file|run_command|edit_file|write_file|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "cd .. && { [ ! -f tooling/scripts/read-budget.mjs ] || node tooling/scripts/read-budget.mjs; }",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/read-budget.mjs ] || node tooling/scripts/read-budget.mjs --reset; }",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/hand-drive.mjs ] || node tooling/scripts/hand-drive.mjs --hook; }",
        "timeout": 60
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/git-private.mjs ] || node tooling/scripts/git-private.mjs autosave --hook >/dev/null; } || true; printf '{}'",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/formal-intake-due.mjs ] || node tooling/scripts/formal-intake-due.mjs; }",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/relapse-due.mjs ] || node tooling/scripts/relapse-due.mjs; }",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "D=\"$HOME/.agents/skills/pstack-doctor/scripts/doctor.mjs\"; if [ -f \"$D\" ]; then node \"$D\" due --hook; else printf '{}'; fi",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "cd .. && { [ ! -f tooling/scripts/dev-servers.mjs ] || node tooling/scripts/dev-servers.mjs --hook; }",
        "timeout": 30
      }
    ]
  }
}
