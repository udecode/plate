{
  "permissions": {
    "allow": ["Bash", "Edit", "Skill", "WebFetch", "WebSearch"]
  },
  "enableAllProjectMcpServers": true,
  "autoCompactWindow": 400000,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -d \"$CLAUDE_PROJECT_DIR\" ] || node \"$CLAUDE_PROJECT_DIR/tooling/scripts/autostage-next.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ ! -d \"$CLAUDE_PROJECT_DIR\" ] || node \"$CLAUDE_PROJECT_DIR/tooling/scripts/hand-drive.mjs\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .agents/pstack/reread.mjs --hook AGENTS.md \"$HOME/.claude/pstack-models.md\" .claude/settings.json",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ ! -f .agents/pstack/head.mjs ] || node .agents/pstack/head.mjs; }",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.agents/skills/cleanup/scripts/scan.mjs\" ] || node \"$CLAUDE_PROJECT_DIR/.agents/skills/cleanup/scripts/scan.mjs\" --brief --repo \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(node .agents/pstack/freeze.mjs *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/stale-claims.mjs\" --hook",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(node .agents/pstack/freeze.mjs *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/stale-mutations.mjs\" --hook",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true,
    "vercel@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude",
        "ref": "v0.9.88"
      }
    }
  }
}
