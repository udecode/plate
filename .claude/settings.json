{
  "permissions": {
    "allow": ["Bash", "Edit", "Skill", "WebFetch", "WebSearch"]
  },
  "enableAllProjectMcpServers": true,
  "autoCompactWindow": 600000,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/autostage-next.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/hand-drive.mjs\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .agents/pstack/reread.mjs --hook AGENTS.md \"$HOME/.claude/pstack-models.md\" .claude/settings.json",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(node .agents/pstack/freeze.mjs *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/stale-claims.mjs\" --hook",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(node .agents/pstack/freeze.mjs *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/stale-mutations.mjs\" --hook",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude",
        "ref": "v0.9.84"
      }
    }
  }
}
