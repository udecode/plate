  ],
  "evidenceReuse": "Fresh first-principles source and consumer comparison. Adjacent model/read/transaction decisions supply context only; focused contracts and a facet-only prototype supply the stated evidence.",
  "summary": "Remove unused facets and unconditional cache/revision bookkeeping; retain document fields/effects and existing contribution/read owners.",
  "verdict": "pursue",
  "previous": null,
  "relation": "initial",
  "alternatives": [
    "Keep/configure: fields/effects have real consumers; zero providers does not disable facet draft bookkeeping.",
    "Change API: lazy opt-in facets would remove idle cost but preserve an unused dependency/cache protocol.",
    "Add primitive: no current job justifies a new generic reactive store or selector registry.",
    "Delete/merge: remove defineFacet, facetProviders, facet reads/types and cache/revision machinery; existing read helpers and ordered contribution points retain actual jobs.",
    "Move ownership: keep persistence/replay below React and local UI above the substrate.",
    "Replace: hidden document nodes or one combined application/document state graph distort grammar or lifetime."
  ],
