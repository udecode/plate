    },
    {
      "record": "2026-10-01-dnd-transfer-consolidation-design-amended",
      "question": "Which native drag owner and UI policies should block dragging and drop indicators reuse?",
      "action": "retains",
      "reason": "Retain the amended native adoption target and explicit React DnD deletion. A library remains responsible only for delegated gesture behavior; no published backend framework is justified."
    },
    {
      "record": "2026-10-02-dnd-transfer-consolidation-execution",
      "question": "Which native drag owner and UI policies should block dragging and drop indicators reuse?",
      "action": "retains",
      "reason": "Retain adopted native transfer as the baseline and all partial-proof limits. Existing development-build measurements do not decide PDD or modern dnd-kit cost, and this source review certifies no later concurrent repairs."
    }
