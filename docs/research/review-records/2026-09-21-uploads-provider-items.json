  "date": "2026-09-21",
  "question": "Should upload registry consumers install one combined R2/S3 gateway, or choose separate ephemeral, R2 and S3 provider items over a shared gateway owner?",
  "model": "gpt-6",
  "method": "best-api-review/history-v3",
  "trigger": "The user challenged why the copied upload component forces provider code on consumers and requested one DRY registry item per provider.",
  "requirements": [
    "The upload UI item installs no server route or storage provider.",
    "Ephemeral, R2 and S3 are explicit opt-in registry choices with one-command install paths.",
    "Each provider installs only its own runtime dependencies and environment contract.",
    "Authentication, ACLs, durable download URLs and gateway error policy remain in one shared owner.",
    "The ephemeral path remains browser-local, revokes object URLs and is not presented as persistent storage."
  ],
  "evidenceReuse": "Reuse the accepted Files SDK protocol, fail-closed gateway policy, live R2 proof and browser-local upload proof. Reopen only registry installation ownership because the combined files-api item and the new ephemeral demo exposed three independent consumer choices.",
  "summary": "Pursue a provider-neutral upload item plus opt-in upload-ephemeral, upload-r2 and upload-s3 items. Keep gateway policy in one shared files-api support item, delete the runtime FILES_STORAGE_PROVIDER branch, and let each persistent provider contribute only a thin route adapter and its own dependencies.",
  "verdict": "pursue",
  "previous": "2026-09-20-uploads-files-server-colocation",
  "relation": "supersedes",
  "reconciliation": [
    {
      "record": "2026-09-20-uploads-files-server-colocation",
      "question": "Should Files SDK storage provider construction remain in files-storage.ts, move into the route, or live with the copied server gateway in files.ts?",
      "action": "supersedes",
      "reason": "The prior colocation was correct only while R2 and S3 shipped as one files-api choice. Explicit provider install boundaries now require common gateway policy to stay shared while adapter construction moves to each provider item."
    },
    {
      "record": "2026-09-20-uploads-files-server-colocation-implementation",
      "question": "Who owns an upload after a placeholder moves, disappears, is undone or outlives its editor, and can provider-specific state be removed?",
      "action": "supersedes",
      "reason": "Replace the combined provider payload with a shared gateway support item and thin provider routes; retain its tested gateway policy."
    },
    {
      "record": "2026-09-20-uploads-r2-live-verification",
      "question": "Who owns an upload after a placeholder moves, disappears, is undone or outlives its editor, and can provider-specific state be removed?",
      "action": "retains",
      "reason": "The live R2 proof still validates the same Files SDK adapter and gateway behavior and does not require a combined provider item."
    },
    {
      "record": "2026-09-20-uploads-playground-ephemeral-implementation",
      "question": "Who owns an upload after a placeholder moves, disappears, is undone or outlives its editor, and can provider-specific state be removed?",
      "action": "retains",
      "reason": "Retain browser-local object URLs, cleanup and browser proof while promoting that configuration to its own opt-in registry item."
    }
  ],
  "alternatives": [
    "Keep upload dependent on one combined files-api item: reject because every UI consumer receives a server route, both provider contracts and AWS dependencies.",
    "Move provider selection into upload.tsx: reject because browser UI must not own credentials, adapters or server routing.",
    "Duplicate the complete gateway in every provider item: reject because ACL, namespace, response and error policy would drift.",
    "Share the provider-neutral gateway and publish thin opt-in provider items: accept because install ownership follows the consumer choice while security policy remains DRY."
  ],
  "proofLimits": "The review chooses registry ownership. Execution must prove isolated generated payloads and dependency closure, installed gateway tests, R2 and S3 source typechecks, ephemeral cleanup, fresh registry generation and both browser upload paths. Existing live R2 evidence may be reused because adapter semantics do not change; live S3 remains unverified.",
