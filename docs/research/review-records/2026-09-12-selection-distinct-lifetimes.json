{
  "id": "2026-09-12-selection-distinct-lifetimes",
  "scope": "selection",
  "kind": "review",
  "date": "2026-09-12",
  "question": "Which location guarantees survive edits, deletion, movement and root changes, and where do text, node and range targets need distinct contracts?",
  "model": "GPT-6 / Codex",
  "method": "best-api-review/history-v2; first-principles hard-cut comparison",
  "trigger": "User requested the next ledger item after Plate core. The queue selected plite-view: five architectural questions assessed together, with product implementation and publication outside scope.",
  "requirements": [
    "Text selection preserves direction/affinity and exact node selection preserves disjoint membership and directional endpoints.",
    "Durable anchors preserve association/deletion policy and root identity across edits, movement, async work and persistence; ordinary coordinates do not require release ownership.",
    "Projected selection may span rendered root occurrences or retained authored fragments without becoming another serialized canonical selection."
  ],
  "evidenceReuse": "Initial scoped ledger assessment from live selection/anchor/view code, table and async-media consumers, and inspected mapping/root/anchor assertions. Related August selection plans and core decisions supply context, not imported verdicts or replayed proof.",
  "summary": "Keep distinct coordinate, selection and anchor contracts plus private projected-view targeting. Universal locations, bounding ranges or React-owned canonical selection lose current semantics or relocate required work.",
  "verdict": "stop",
  "previous": null,
  "relation": "initial",
  "alternatives": [
    "Keep/configure: static Path/Point/Range, canonical text/node selection and explicit durable Anchor lifetime fit the observed jobs.",
    "Change API: flattening selection to one representative range loses exact disjoint membership; singular and plural queries are projections of one owner.",
    "Add primitive: a universal live location or extensible selection-kind registry adds lifecycle and competing-state complexity without a current missing job.",
    "Delete/merge/inline: deleting anchors loses async rebasing; replacing static coordinates with anchors adds release work; deleting NodeSelection loses exact membership.",
    "Move ownership: model selection and rebasing belong below React; occurrence/fragment-aware projected selection belongs to mounted input handling.",
    "Replace architecture: DOM-only selection cannot serve headless/history/collaboration; node keys alone cannot locate text offsets; serializing cross-root view coordinates mixes DOM and document identity."
  ],
  "proofLimits": "Source and selected tests inspected but not run. No mapping-complexity, native-input, actual-device or whole-feature behavior certification. Stop is against these replacements; table/media are consumer evidence, not completed feature reviews.",
